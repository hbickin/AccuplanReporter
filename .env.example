# --- Accuplan MSSQL baglantisi -------------------------------------------
# Varsayilan (adlandirilmamis) ornek:
DB_SERVER=SUNUCU-ADI
DB_PORT=1433
#
# Named instance (or. SUNUCU\SQLEXPRESS) icin iki yazim da calisir:
#   DB_SERVER=SUNUCU\SQLEXPRESS          <- ters bolu ile tek satirda
#   DB_SERVER=SUNUCU + DB_INSTANCE=SQLEXPRESS
# Named instance kullanirken DB_PORT satirini SILIN: port ve ornek adi ayni
# anda verilemez. Baglanti SQL Browser servisi uzerinden kurulur; bu servis
# kapaliysa ornek adi yerine ornegin sabit portunu DB_PORT ile verin.
# DB_INSTANCE=SQLEXPRESS

DB_DATABASE=Accuplan
DB_USER=accuplan_read
DB_PASSWORD=sifre
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# --- Uygulama -------------------------------------------------------------
PORT=3000
# Veritabani olmadan sample/ klasorundeki ornek is emri ile denemek icin:
DEMO_MODE=0
# Kaydedilen raporlarin klasoru (varsayilan: data/reports)
# REPORT_DIR=C:\Accuplan\Raporlar
